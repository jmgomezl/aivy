# ─── Hedera ───────────────────────────────────────
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=0.0.XXXXXX
HEDERA_PRIVATE_KEY=302e020100300506032b657004220420...
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1
SERVER_PORT=3001

# ─── AWS KMS (enables secure key management) ─────
# When configured, each agent's signing key is encrypted by a dedicated
# KMS symmetric key. Private keys are NEVER stored in plaintext.
# Without these, falls back to local AES-256-GCM encryption.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# ─── AI & Wallet ─────────────────────────────────
OPENAI_API_KEY=sk-...
VITE_WALLETCONNECT_PROJECT_ID=

# ─── Security (auto-generated on first run if not set) ───
# MASTER_ENCRYPTION_KEY=  (64 hex chars, 32 bytes — additional encryption layer on top of KMS)
# JWT_SECRET=             (session signing key — sessions reset if changed)

# AWS KMS — Envelope encryption for agent signing keys (optional but recommended)
# When configured, each deployed agent gets a dedicated KMS symmetric key
# that wraps its Ed25519 private key. Keys are never stored in plaintext.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# SaucerSwap DEX — API key for token swaps, pool queries, and farming
# Request a key at support@saucerswap.finance
# SAUCERSWAP_API_KEY=
