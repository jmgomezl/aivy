HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=0.0.000000
HEDERA_PRIVATE_KEY=302e020100300506032b657004220420...
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1
SERVER_PORT=3001

# LLM Provider (enables AI chat with agents)
OPENAI_API_KEY=sk-...

# Required for wallet connect in the frontend
VITE_WALLETCONNECT_PROJECT_ID=

# Security: auto-generated on first run if not set
# MASTER_ENCRYPTION_KEY=  (64 hex chars, 32 bytes — encrypts agent private keys at rest)
# JWT_SECRET=             (session signing key — sessions reset if changed)

# AWS KMS — Envelope encryption for agent signing keys (optional but recommended)
# When configured, each deployed agent gets a dedicated KMS symmetric key
# that wraps its Ed25519 private key. Keys are never stored in plaintext.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
